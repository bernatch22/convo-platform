# Copy to .env — never commit real values.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=   # only for identity-linked keys (wrkspc_...)
SONIOX_API_KEY=           # voice: Soniox stt-rt-v5 (without it the session is text-only)
DEEPGRAM_API_KEY=         # voice: only for projects whose stt_provider is deepgram (Flux)
ELEVENLABS_API_KEY=       # voice: ElevenLabs, voice id lives on each project
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
FLEET=cc

# scripts/twilio_trunk.py only — the auth token OR the API key/secret pair
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
