# Copy to .env — never commit real values.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=   # only for identity-linked keys (wrkspc_...)
OPENAI_API_KEY=           # only for gpt-5.4-mini: the second allowed model (evals, overrides)
SONIOX_API_KEY=           # voice: Soniox stt-rt-v5 (without it the session is text-only)
DEEPGRAM_API_KEY=         # voice: only for projects whose stt_provider is deepgram (Flux)
ELEVENLABS_API_KEY=       # voice: ElevenLabs, voice id lives on each project
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
FLEET=cc

# Ring 4: every finished call scores itself from api.py (docs/evals.md §3.13).
# The defaults are the ones the box runs on; each line is an off switch.
SCORING_SWEEP=1           # 0 = this control plane scores nothing at all
SCORING_SWEEP_S=10        # seconds between sweeps for finished, unscored calls
SCORING_BATCH=3           # sessions scored per sweep, so a backlog drains slowly
SCORING_WINDOW_S=86400    # how far back a sweep looks for unscored calls
SCORING_CAP_EUR=0.01      # the judge's per-call ceiling, refused BEFORE it is spent
SCORING_JUDGE_MODEL=claude-haiku-4-5
SCORING_JUDGE_THRESHOLD=0.7

# ms-17: every voice call keeps its audio. Recordings hold PII — they live
# outside git and leave only through GET /sessions/{id}/recording.
CONVO_RECORDINGS=tmp/recordings   # /var/lib/convo/recordings on the box
RECORDINGS_TOKEN=                 # set on any box reachable from outside its network
RECORD=1                          # 0 = this deploy records nothing at all

# scripts/twilio_trunk.py only — the auth token OR the API key/secret pair
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
